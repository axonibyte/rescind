rescind 0
# Negative case E0204: a knell without a cost probe and without :none with a
# reason. The front end must refuse with exactly E0204.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  # So the case is wrong only in the way it is named for: a knell whose ack
  # names humans needs something that can verify a proof, or it is also E0611.
  approval via: hook(:authority)
  backstop scheduler: cron()
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
  hooks do
    registrar :requester, user: "ops", may_register: [:authority]
  end
end

defop :fence, _ do
  footprint
  do: hook(:fence)
  refusal: knell, guard: verified_off, ack: :none, reason: "driver verified off"
  undo_locus: :none
end

defplan :fence, %{name: "db-01"} do
  wane 1h
  knell fence()
end
