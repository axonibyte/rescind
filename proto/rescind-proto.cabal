cabal-version: 3.0
name:          rescind-proto
version:       0.0.1
synopsis:      rescind Phase 0 prototype checker (kept as a record, not a product)
description:
  The Phase 0 prototype of rescind's core algebra: footprint kinds, undo loci, the
  refusal lattice, intent, backstop triggers, three-valued guards and the
  reach rule, composed into a checker whose verdicts are golden-tested
  against the four acceptance tenants. See docs/ROADMAP.md, Phase 0.
license:       BSD-2-Clause
-- The license text is ../LICENSE at the repository root; cabal refuses a
-- relative path outside the package, and the SPDX id above is the record.
author:        Axonibyte Innovations, LLC
build-type:    Simple
tested-with:   GHC ==9.10.3

common shared
  default-language: GHC2021
  ghc-options:
    -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wpartial-fields -Wredundant-constraints -Wmissing-export-lists
  build-depends:
    base ^>=4.20,
    bytestring,
    containers,
    text

-- The framework: tenant-free. The seam guard scans this directory.
library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Rescind.Proto.Algebra
    Rescind.Proto.Backstop
    Rescind.Proto.Check
    Rescind.Proto.Diagnostics
    Rescind.Proto.Explain
    Rescind.Proto.Gates
    Rescind.Proto.Intent
    Rescind.Proto.Interference
    Rescind.Proto.Json.Canonical
    Rescind.Proto.Ledger
    Rescind.Proto.Model
    Rescind.Proto.Prose
    Rescind.Proto.States
    Rescind.Proto.Verdict
  build-depends:
    aeson,
    scientific,
    vector

executable rescind-proto-states
  import:         shared
  hs-source-dirs: app
  main-is:        States.hs
  build-depends:
    rescind-proto,
    text

test-suite rescind-proto-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  other-modules:
    Test.Canonical
    Test.Check
    Test.Diagnostics
    Test.Laws
    Test.Ledger
    Test.States
  build-depends:
    rescind-proto,
    aeson,
    QuickCheck,
    tasty,
    tasty-hunit,
    tasty-quickcheck,
    vector
